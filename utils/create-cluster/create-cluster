#!/bin/bash

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"

# Settings
BIN_PATH="$SCRIPT_DIR/../../src/"
CLUSTER_HOST=127.0.0.1
PORT=30000
TIMEOUT=2000
NODES=6
REPLICAS=1
PROTECTED_MODE=yes
# The nodes talk over an unauthenticated cluster bus on loopback, which a cluster
# node refuses to do by default, so protection has to be waived explicitly.
BUS_PROTECTED_MODE=no
STARTUP_RETRIES=50
STARTUP_RETRY_DELAY=0.1
ADDITIONAL_OPTIONS=""

# You may want to put the above config parameters into config.sh in order to
# override the defaults without modifying this script.

if [ -a config.sh ]
then
    source "config.sh"
fi

# Computed vars
ENDPORT=$((PORT+NODES))

if [ "$1" == "start" ]
then
    while [ $((PORT < ENDPORT)) != "0" ]; do
        PORT=$((PORT+1))
        echo "Starting $PORT"
        $BIN_PATH/redis-server --port $PORT --protected-mode $PROTECTED_MODE --cluster-enabled yes --cluster-bus-port-protected-mode $BUS_PROTECTED_MODE --cluster-config-file nodes-${PORT}.conf --cluster-node-timeout $TIMEOUT --appendonly yes --appendfilename appendonly-${PORT}.aof --appenddirname appendonlydir-${PORT} --dbfilename dump-${PORT}.rdb --logfile ${PORT}.log --daemonize yes ${ADDITIONAL_OPTIONS}
    done
    exit 0
fi

if [ "$1" == "start-and-create" ]
then
    # Redis may still bind IPv6 when an IPv4 port is occupied. Check both the
    # client and bus ports before launching any nodes.
    for ((p=PORT+1; p<=ENDPORT; p++)); do
        for check_port in "$p" "$((p+10000))"; do
            if (: >/dev/tcp/127.0.0.1/"$check_port") 2>/dev/null; then
                echo "Port $check_port is already in use." >&2
                exit 1
            fi
        done
    done

    # Resolve paths before changing to the temporary working directory.
    BIN_PATH=$(cd -- "$BIN_PATH" && pwd) || exit 1
    TMP_BASE=$(cd -- "${TMPDIR:-/tmp}" && pwd) || exit 1
    RUN_DIR=""

    cleanup() {
        status=$?
        trap - EXIT
        trap '' INT TERM
        echo "Stopping temporary cluster..."

        # Only signal our own background jobs, never a process found by port or
        # a PID file. Include stopped jobs so cleanup also handles stuck nodes.
        for pid in $(jobs -pr) $(jobs -ps); do
            kill -TERM "$pid" 2>/dev/null
            kill -CONT "$pid" 2>/dev/null
        done
        for ((attempt=0; attempt<50; attempt++)); do
            [ -z "$(jobs -pr)$(jobs -ps)" ] && break
            sleep 0.1
        done
        for pid in $(jobs -pr) $(jobs -ps); do
            echo "Force stopping process $pid." >&2
            kill -KILL "$pid" 2>/dev/null
        done
        for ((attempt=0; attempt<10; attempt++)); do
            [ -z "$(jobs -pr)$(jobs -ps)" ] && break
            sleep 0.1
        done
        if [ -n "$(jobs -pr)$(jobs -ps)" ]; then
            echo "Cleanup failed; keeping $RUN_DIR." >&2
            exit 1
        fi
        wait
        if [ -n "$RUN_DIR" ]; then
            rm -rf -- "$RUN_DIR" || status=1
        fi
        exit "$status"
    }

    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    RUN_DIR=$(mktemp -d "$TMP_BASE/redis-cluster.XXXXXX") || exit 1
    cd -- "$RUN_DIR" || exit 1

    # Wait interruptibly, with a deadline: redis-cli can otherwise wait forever
    # for a reply or for the cluster bus to converge. Track it as our own job.
    run_cli() {
        local cli_pid deadline timeout=$1
        shift
        "$BIN_PATH/redis-cli" "$@" &
        cli_pid=$!
        deadline=$((SECONDS+timeout))
        while [ "$SECONDS" -lt "$deadline" ]; do
            kill -0 "$cli_pid" 2>/dev/null || break
            sleep 0.1 &
            wait $!
        done
        if kill -0 "$cli_pid" 2>/dev/null; then
            echo "redis-cli timed out." >&2
            kill -KILL "$cli_pid" 2>/dev/null
            wait "$cli_pid" 2>/dev/null
            return 1
        fi
        wait "$cli_pid"
    }

    HOSTS=()
    NODE_PIDS=()
    for ((p=PORT+1; p<=ENDPORT; p++)); do
        echo "Starting $p"
        "$BIN_PATH/redis-server" \
            --protected-mode "$PROTECTED_MODE" \
            --cluster-enabled yes \
            --cluster-bus-port-protected-mode "$BUS_PROTECTED_MODE" \
            --cluster-node-timeout "$TIMEOUT" \
            --appendonly yes \
            ${ADDITIONAL_OPTIONS} \
            --port "$p" --cluster-port "$((p+10000))" \
            --cluster-config-file "nodes-${p}.conf" \
            --appendfilename "appendonly-${p}.aof" \
            --appenddirname "appendonlydir-${p}" \
            --dbfilename "dump-${p}.rdb" \
            --logfile "$RUN_DIR/${p}.log" \
            --dir "$RUN_DIR" --pidfile "$RUN_DIR/redis-${p}.pid" \
            --daemonize no --supervised no &
        node_pid=$!
        NODE_PIDS+=("$node_pid")
        HOSTS+=("$CLUSTER_HOST:$p")

        retries=$STARTUP_RETRIES
        while true; do
            # Verify the responding server is the child we just launched. A
            # successful PING alone could belong to an unrelated Redis instance.
            if run_cli 1 -h "$CLUSTER_HOST" -p "$p" INFO server > ready 2>/dev/null &&
                grep -q "^process_id:${node_pid}$(printf '\r')$" ready &&
                kill -0 "$node_pid" 2>/dev/null; then
                break
            fi
            retries=$((retries-1))
            if ! kill -0 "$node_pid" 2>/dev/null || [ "$retries" -le 0 ]; then
                echo "Node $p failed to start; check for occupied client or cluster bus ports." >&2
                cat "$RUN_DIR/${p}.log" >&2
                exit 1
            fi
            sleep "$STARTUP_RETRY_DELAY" &
            wait $!
        done
    done

    run_cli 60 --cluster create "${HOSTS[@]}" \
        --cluster-replicas "$REPLICAS" --cluster-yes || exit $?

    echo "Cluster ready. Press Ctrl+C to stop and clean up."
    while true; do
        for pid in "${NODE_PIDS[@]}"; do
            if ! kill -0 "$pid" 2>/dev/null; then
                echo "A Redis node exited unexpectedly." >&2
                exit 1
            fi
        done
        sleep 1 &
        wait $!
    done
fi

if [ "$1" == "create" ]
then
    HOSTS=""
    while [ $((PORT < ENDPORT)) != "0" ]; do
        PORT=$((PORT+1))
        HOSTS="$HOSTS $CLUSTER_HOST:$PORT"
    done
    OPT_ARG=""
    if [ "$2" == "-f" ]; then
        OPT_ARG="--cluster-yes"
    fi
    $BIN_PATH/redis-cli --cluster create $HOSTS --cluster-replicas $REPLICAS $OPT_ARG
    exit 0
fi

if [ "$1" == "stop" ]
then
    while [ $((PORT < ENDPORT)) != "0" ]; do
        PORT=$((PORT+1))
        echo "Stopping $PORT"
        $BIN_PATH/redis-cli -p $PORT shutdown nosave
    done
    exit 0
fi

if [ "$1" == "restart" ]
then
    OLD_PORT=$PORT
    while [ $((PORT < ENDPORT)) != "0" ]; do
        PORT=$((PORT+1))
        echo "Stopping $PORT"
        $BIN_PATH/redis-cli -p $PORT shutdown nosave
    done
    PORT=$OLD_PORT
    while [ $((PORT < ENDPORT)) != "0" ]; do
        PORT=$((PORT+1))
        echo "Starting $PORT"
        $BIN_PATH/redis-server --port $PORT --protected-mode $PROTECTED_MODE --cluster-enabled yes --cluster-bus-port-protected-mode $BUS_PROTECTED_MODE --cluster-config-file nodes-${PORT}.conf --cluster-node-timeout $TIMEOUT --appendonly yes --appendfilename appendonly-${PORT}.aof --appenddirname appendonlydir-${PORT} --dbfilename dump-${PORT}.rdb --logfile ${PORT}.log --daemonize yes ${ADDITIONAL_OPTIONS}
    done
    exit 0
fi

if [ "$1" == "watch" ]
then
    PORT=$((PORT+1))
    while [ 1 ]; do
        clear
        date
        $BIN_PATH/redis-cli -p $PORT cluster nodes | head -30
        sleep 1
    done
    exit 0
fi

if [ "$1" == "tail" ]
then
    INSTANCE=$2
    PORT=$((PORT+INSTANCE))
    tail -f ${PORT}.log
    exit 0
fi

if [ "$1" == "tailall" ]
then
    tail -f *.log
    exit 0
fi

if [ "$1" == "call" ]
then
    while [ $((PORT < ENDPORT)) != "0" ]; do
        PORT=$((PORT+1))
        $BIN_PATH/redis-cli -p $PORT $2 $3 $4 $5 $6 $7 $8 $9
    done
    exit 0
fi

if [ "$1" == "clean" ]
then
    echo "Cleaning *.log"
    rm -rf *.log
    echo "Cleaning appendonlydir-*"
    rm -rf appendonlydir-*
    echo "Cleaning dump-*.rdb"
    rm -rf dump-*.rdb
    echo "Cleaning nodes-*.conf"
    rm -rf nodes-*.conf
    exit 0
fi

if [ "$1" == "clean-logs" ]
then
    echo "Cleaning *.log"
    rm -rf *.log
    exit 0
fi

echo "Usage: $0 [start|start-and-create|create|stop|restart|watch|tail|tailall|clean|clean-logs|call]"
echo "start       -- Launch Redis Cluster instances."
echo "start-and-create -- Run a temporary cluster; Ctrl+C stops and cleans up."
echo "create [-f] -- Create a cluster using redis-cli --cluster create."
echo "stop        -- Stop Redis Cluster instances."
echo "restart     -- Restart Redis Cluster instances."
echo "watch       -- Show CLUSTER NODES output (first 30 lines) of first node."
echo "tail <id>   -- Run tail -f of instance at base port + ID."
echo "tailall     -- Run tail -f for all the log files at once."
echo "clean       -- Remove all instances data, logs, configs."
echo "clean-logs  -- Remove just instances logs."
echo "call <cmd>  -- Call a command (up to 7 arguments) on all nodes."
