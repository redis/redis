        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "capacity",
                "type": "integer",
                "token": "CAPACITY",
                "optional": true
            },
            {
                "name": "error",
                "type": "double",
                "token": "ERROR",
                "optional": true
            },
            {
                "name": "expansion",
                "type": "integer",
                "token": "EXPANSION",
                "optional": true
            },
            {
                "name": "nocreate",
                "token": "NOCREATE",
                "type": "pure-token",
                "optional": true
            },
            {
                "name": "nonscaling",
                "token": "NONSCALING",
                "type": "pure-token",
                "optional": true
            },
            {
                "name": "items",
                "token": "ITEMS",
                "type": "pure-token"
            },
            {
                "name": "item",
                "type": "string",
                "multiple": true
            }
        ],
        "since": "8.12.0",
        "group": "bloom",
