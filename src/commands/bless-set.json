{
    "SET": {
        "summary": "Blesses a key at a protection level.",
        "complexity": "O(1).",
        "group": "generic",
        "since": "8.6.0",
        "arity": 4,
        "container": "BLESS",
        "function": "blessCommand",
        "command_flags": [
            "WRITE",
            "DENYOOM"
        ],
        "acl_categories": [
            "KEYSPACE"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 2
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "level",
                "type": "oneof",
                "arguments": [
                    { "name": "none",    "type": "pure-token", "token": "NONE" },
                    { "name": "noevict", "type": "pure-token", "token": "NOEVICT" }
                ]
            }
        ],
        "reply_schema": {
            "type": "integer",
            "description": "1 if the key's bless level changed, 0 otherwise."
        }
    }
}
