{
    "CONVERT": {
        "summary": "Converts a bitmap key between the string and native compressed representations.",
        "complexity": "O(N) with N being the number of bytes of the string representation, or the number of set bits when converting back to a string.",
        "group": "bitmap",
        "since": "8.10.0",
        "arity": -3,
        "container": "BITMAP",
        "function": "bitmapCommand",
        "command_flags": [
            "WRITE",
            "DENYOOM"
        ],
        "acl_categories": [
            "BITMAP"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 2
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "representation",
                "type": "oneof",
                "optional": true,
                "arguments": [
                    {
                        "name": "native",
                        "type": "pure-token",
                        "token": "NATIVE"
                    },
                    {
                        "name": "string",
                        "type": "pure-token",
                        "token": "STRING"
                    }
                ]
            }
        ],
        "reply_schema": {
            "const": "OK"
        }
    }
}
