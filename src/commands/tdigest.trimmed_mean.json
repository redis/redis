{
    "TDIGEST.TRIMMED_MEAN": {
        "summary": "Returns an estimation of the mean value from the sketch, excluding observation values outside the low and high cutoff quantiles",
        "complexity": "O(N) where N is the number of centroids",
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "low-cut-quantile",
                "type": "double"
            },
            {
                "name": "high-cut-quantile",
                "type": "double"
            }
        ],
        "since": "8.8.0",
        "group": "tdigest",
        "function": "tdigestQueryCommand",
        "arity": 4,
        "command_flags": [
            "READONLY"
        ],
        "acl_categories": [
            "TDIGEST"
        ],
        "key_specs": [
            {
                "flags": [
                    "RO",
                    "ACCESS"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ]
    }
}
