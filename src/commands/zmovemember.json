{
    "ZMOVEMEMBER": {
        "summary": "Moves specified members from one sorted set to another, preserving scores. Can restrict moves to members absent from or present in the destination. Deletes the source sorted set if the last member was moved.",
        "complexity": "O(K*(log(N)+log(M))) where K is the number of given members and N and M are the source and destination sizes.",
        "group": "sorted_set",
        "since": "8.12.0",
        "arity": -6,
        "function": "zmovememberCommand",
        "command_flags": [
            "WRITE",
            "DENYOOM"
        ],
        "acl_categories": [
            "SORTEDSET"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "ACCESS",
                    "DELETE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            },
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 2
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "oneOf": [
                {
                    "description": "No members were moved: the source key does not exist, none of the given members exists in the source or meets the destination condition, or source and destination are the same sorted set.",
                    "type": "null"
                },
                {
                    "description": "Moved member and score pairs, nested even for one member, in the order the members were given. Missing members are skipped, duplicates are moved once, and members excluded by NX or XX remain in the source.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": [
                            {
                                "description": "Member",
                                "type": "string"
                            },
                            {
                                "description": "Score",
                                "type": "number"
                            }
                        ]
                    }
                }
            ]
        },
        "arguments": [
            {
                "name": "source",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "destination",
                "type": "key",
                "key_spec_index": 1
            },
            {
                "name": "condition",
                "type": "oneof",
                "optional": true,
                "arguments": [
                    {
                        "name": "nx",
                        "type": "pure-token",
                        "token": "NX"
                    },
                    {
                        "name": "xx",
                        "type": "pure-token",
                        "token": "XX"
                    }
                ]
            },
            {
                "name": "members",
                "token": "MEMBERS",
                "type": "block",
                "arguments": [
                    {
                        "name": "num-members",
                        "type": "integer"
                    },
                    {
                        "name": "member",
                        "type": "string",
                        "multiple": true
                    }
                ]
            }
        ]
    }
}
