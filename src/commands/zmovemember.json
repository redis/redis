{
    "ZMOVEMEMBER": {
        "summary": "Moves one or more members from one sorted set to another, preserving their scores. Deletes the source sorted set if the last member was moved.",
        "complexity": "O(K*(log(N)+log(M))) where K is the number of given members and N and M are the source and destination sizes.",
        "group": "sorted_set",
        "since": "8.12.0",
        "arity": -4,
        "function": "zmovememberCommand",
        "command_flags": [
            "WRITE",
            "DENYOOM"
        ],
        "acl_categories": [
            "SORTEDSET"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "ACCESS",
                    "DELETE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            },
            {
                "flags": [
                    "RW",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 2
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ],
        "reply_schema": {
            "oneOf": [
                {
                    "description": "The source key does not exist, none of the given members exists in the source key, or source and destination are the same sorted set.",
                    "type": "null"
                },
                {
                    "description": "Moved member and score pairs, in the order the members were given.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": [
                            {
                                "description": "Member",
                                "type": "string"
                            },
                            {
                                "description": "Score",
                                "type": "number"
                            }
                        ]
                    }
                }
            ]
        },
        "arguments": [
            {
                "name": "source",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "destination",
                "type": "key",
                "key_spec_index": 1
            },
            {
                "name": "member",
                "type": "string",
                "multiple": true
            }
        ]
    }
}
