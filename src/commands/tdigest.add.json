{
    "TDIGEST.ADD": {
        "summary": "Adds one or more observations to a t-digest sketch",
        "complexity": "O(N), where N is the number of samples to add",
        "arguments": [
            {
                "name": "key",
                "type": "key",
                "key_spec_index": 0
            },
            {
                "name": "value",
                "type": "double",
                "multiple": true
            }
        ],
        "since": "8.8.0",
        "group": "tdigest",
        "function": "tdigestAddCommand",
        "arity": -3,
        "command_flags": [
            "WRITE",
            "DENYOOM"
        ],
        "acl_categories": [
            "TDIGEST"
        ],
        "key_specs": [
            {
                "flags": [
                    "RW",
                    "ACCESS",
                    "UPDATE"
                ],
                "begin_search": {
                    "index": {
                        "pos": 1
                    }
                },
                "find_keys": {
                    "range": {
                        "lastkey": 0,
                        "step": 1,
                        "limit": 0
                    }
                }
            }
        ]
    }
}
