      },
      {
        "name": "element",
        "type": "string"
      },
      {
        "token": "CAS",
        "name": "cas",
        "type": "pure-token",
        "optional": true
      },
      {
        "name": "quant_type",
        "type": "oneof",
        "optional": true,
        "arguments": [
          {
            "name": "noquant",
            "type": "pure-token",
            "token": "NOQUANT"
          },
          {
            "name": "bin",
            "type": "pure-token",
            "token": "BIN"
          },
          {
            "name": "q8",
            "type": "pure-token",
            "token": "Q8"
          }
        ]
      },
      {
        "token": "EF",
        "name": "build-exploration-factor",
        "type": "integer",
        "optional": true
      },
      {
        "token": "SETATTR",
        "name": "attributes",
        "type": "string",
        "optional": true
      },
      {
        "token": "M",
        "name": "numlinks",
        "type": "integer",
        "optional": true
      }
